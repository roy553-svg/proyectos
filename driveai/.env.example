# =====================================================================
# DriveAI :: copia este archivo a .env y ajusta lo que necesites.
#
# TODO es opcional. Sin ninguna variable, DriveAI arranca y responde
# con su motor determinista local.
# =====================================================================

# --- Google Gemini (nivel gratuito: https://aistudio.google.com/apikey) ---
# Sin clave, el sistema NO falla: usa el motor de reglas local.
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Presupuesto de latencia. Agotado -> responde el motor local.
GEMINI_TIMEOUT_MS=3500

# --- Brevedad de seguridad vial ---
MAX_SENTENCES=3
MAX_ANSWER_CHARS=240

# --- Base de datos (memoria de 4 capas) ---
POSTGRES_USER=driveai
POSTGRES_PASSWORD=driveai
POSTGRES_DB=driveai
POSTGRES_PORT=5432

# --- Cache y rate limiting de voz ---
REDIS_PORT=6379
ANSWER_CACHE_TTL=900
VOICE_RATE_LIMIT=20
VOICE_RATE_WINDOW=60

# --- Gateway ---
BACKEND_PORT=8080

# --- Proveedor vehicular: mock | generic-android | tesla ---
VEHICLE_PROVIDER=mock
# Velocidad (km/h) a partir de la cual se bloquean comandos fisicos.
LOCKOUT_SPEED_KPH=5

# Puente CAN/OBD-II expuesto por la radio Android.
ANDROID_BRIDGE_URL=http://host.docker.internal:8099

# --- Tesla Fleet API v1 (OAuth 2.0 PKCE) ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://localhost/auth/tesla/callback
TESLA_AUDIENCE=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_VEHICLE_TAG=
