<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- La camara se usa unicamente para la experiencia AR y para leer los QR
         de posicionamiento. No se guardan fotos ni videos. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Opcional: solo para sugerir la plaza mas cercana al abrir la app. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- AR opcional: la app se instala y funciona (mapa 2D) sin soporte AR. -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />

    <application
        android:name=".RumboApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_nombre"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rumbo">

        <!-- "optional": Google Play Services for AR no es obligatorio para instalar. -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_nombre"
            android:theme="@style/Theme.Rumbo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
