# ===================================================================
#  BOT DE PRECIOS RD — configuración
#  Copia este archivo como .env  ->  cp .env.example .env
# ===================================================================

# --- OBLIGATORIO ---------------------------------------------------
# Token que te dio @BotFather (formato 1234567890:AAH...)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenDeBotFatherReemplazaEsto

# Chat donde se publican los reportes automáticos.
# Personal: 123456789   |   Grupo: -1001234567890   |   Canal: -1009876543210
TELEGRAM_CHAT_ID=123456789

# --- OPCIONAL ------------------------------------------------------
# Otros chats autorizados a usar los comandos, separados por coma.
ALLOWED_CHAT_IDS=

# Horario de la rutina (por defecto jueves y viernes a las 8:00 AM hora RD)
PHARMACY_CRON_DAY=thu
SUPERMARKET_CRON_DAY=fri
REPORT_HOUR=8
REPORT_MINUTE=0

# Cantidad de productos por reporte
PRODUCTS_PER_REPORT=5

# Capa 1: consulta en línea de catálogos (true/false).
ENABLE_SCRAPING=true
HTTP_TIMEOUT=12
HTTP_MAX_WORKERS=6
CACHE_TTL_HOURS=12
# Fallos seguidos antes de desactivar una tienda durante el reporte
FALLOS_MAX_POR_TIENDA=2

# Capa 2: datos de referencia pública (Pro-Consumidor RD u otra fuente).
# Acepta un JSON {"slug-del-producto": 123.45} o un CSV con columnas producto,precio.
# Déjalo vacío para usar la tabla de referencia interna del bot.
PROCONSUMIDOR_DATA_URL=
REFERENCE_TTL_HOURS=72

# Semanas que un producto descansa antes de poder repetirse en los sorteos
ROTATION_COOLDOWN_WEEKS=4

# Carpeta de datos (caché e historial). Déjalo vacío para usar ./data
DATA_DIR=

# Enviar un reporte al arrancar, para probar: "" | jueves | viernes
SEND_ON_STARTUP=

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
