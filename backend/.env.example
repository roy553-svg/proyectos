# ---------------------------------------------------------------------------
# Configuracion de El Profeta - Backend (Fase 1)
# Copiar a .env y ajustar. NO subir .env al repositorio.
# ---------------------------------------------------------------------------

# Nombre y version expuestos por la API / OpenAPI
APP_NAME="El Profeta API"
APP_VERSION="0.1.0"

# debug=true activa el autorecargado recomendado en desarrollo y logs SQL
DEBUG=true

# Prefijo del router versionado
API_V1_PREFIX="/api/v1"

# ---------------------------------------------------------------------------
# Base de datos
# SQLite (desarrollo):
DATABASE_URL="sqlite:///./database.db"
# PostgreSQL (produccion), ejemplo:
# DATABASE_URL="postgresql+psycopg://profeta:CAMBIAME@localhost:5432/profeta"
# ---------------------------------------------------------------------------

# Muestra el SQL generado por SQLAlchemy (ruidoso, solo para depurar)
SQL_ECHO=false

# Crear las tablas al arrancar la app (util sin Alembic en desarrollo).
# En produccion dejar en false y usar migraciones Alembic.
CREATE_TABLES_ON_STARTUP=true

# ---------------------------------------------------------------------------
# CORS: lista explicita de origenes permitidos (JSON o separada por comas).
# No usar "*" en produccion.
# ---------------------------------------------------------------------------
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8080"

# Numero maximo de articulos que puede devolver el endpoint de noticias
MAX_ARTICLES_PER_RESPONSE=50
