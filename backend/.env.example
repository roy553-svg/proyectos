# ---------------------------------------------------------------------------
# Configuracion de El Profeta - Backend (Fase 1)
# Copiar a .env y ajustar. NO subir .env al repositorio.
# ---------------------------------------------------------------------------

# Nombre y version expuestos por la API / OpenAPI
APP_NAME="El Profeta API"
APP_VERSION="0.2.0"

# debug=true activa el autorecargado recomendado en desarrollo y logs SQL
DEBUG=true

# Prefijo del router versionado
API_V1_PREFIX="/api/v1"

# ---------------------------------------------------------------------------
# Base de datos
# SQLite (desarrollo):
DATABASE_URL="sqlite:///./database.db"
# PostgreSQL (produccion), ejemplo:
# DATABASE_URL="postgresql+psycopg://profeta:CAMBIAME@localhost:5432/profeta"
# ---------------------------------------------------------------------------

# Muestra el SQL generado por SQLAlchemy (ruidoso, solo para depurar)
SQL_ECHO=false

# Crear las tablas al arrancar la app (util sin Alembic en desarrollo).
# En produccion dejar en false y usar migraciones Alembic.
CREATE_TABLES_ON_STARTUP=true

# ---------------------------------------------------------------------------
# CORS: lista explicita de origenes permitidos (JSON o separada por comas).
# No usar "*" en produccion.
# ---------------------------------------------------------------------------
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8080"

# Numero maximo de articulos que puede devolver el endpoint de noticias
MAX_ARTICLES_PER_RESPONSE=50

# ===========================================================================
# FASE 2 - Automatizacion, IA y generacion de video
# Todo es OPCIONAL: sin claves el backend usa adaptadores offline y sigue
# funcionando (noticias de ejemplo, resumen extractivo y sin animaciones).
# NO pongas claves reales en este fichero: va al repositorio.
# ===========================================================================

# Token de los endpoints /api/v1/admin. Vacio = endpoints deshabilitados (503).
ADMIN_API_TOKEN=""

# --- Fuente de noticias (NewsAPI) ---
NEWSAPI_API_KEY=""
NEWSAPI_BASE_URL="https://newsapi.org/v2"
NEWS_LANGUAGE="es"
NEWS_COUNTRY="es"
NEWS_ITEMS_PER_EDITION=8

# --- Redaccion con IA (Gemini) ---
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=60

# --- Generacion de video (Replicate / Stable Video Diffusion) ---
REPLICATE_API_TOKEN=""
REPLICATE_BASE_URL="https://api.replicate.com/v1"
# Hash de la version del modelo en Replicate (p. ej. stability-ai/stable-video-diffusion).
REPLICATE_MODEL_VERSION=""
REPLICATE_TIMEOUT_SECONDS=30
VIDEOS_PER_EDITION=3

# --- Automatizacion (APScheduler) ---
ENABLE_SCHEDULER=false
SCHEDULER_TIMEZONE="UTC"
WEEKLY_PIPELINE_DAY_OF_WEEK="mon"
WEEKLY_PIPELINE_HOUR=6
WEEKLY_PIPELINE_MINUTE=0
VIDEO_POLL_INTERVAL_MINUTES=15
